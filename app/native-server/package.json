{
  "name": "mcp-chrome-bridge",
  "version": "1.0.29",
  "description": "Chrome Native-Messaging host (Node)",
  "main": "dist/index.js",
  "bin": {
    "mcp-chrome-bridge": "./dist/cli.js",
    "chrome-mcp-bridge": "./dist/cli.js",
    "mcp-chrome-stdio": "./dist/mcp/mcp-server-stdio.js"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js,json --ignore dist/ --exec \"npm run build && npm run register:dev\"",
    "build": "ts-node src/scripts/build.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "register:dev": "node dist/scripts/register-dev.js",
    "postinstall": "node dist/scripts/postinstall.js"
  },
  "files": [
    "dist",
    "!dist/node_path.txt"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "preferGlobal": true,
  "keywords": [
    "mcp",
    "chrome",
    "browser"
  ],
  "author": "hangye",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@fastify/cors": "^11.4.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node-fetch": "^2.6.13",
    "better-sqlite3": "^13.2.0",
    "chalk": "^6.0.1",
    "chrome-devtools-frontend": "^1.0.1742811",
    "chrome-mcp-shared": "workspace:*",
    "commander": "^15.1.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "is-admin": "^4.0.0",
    "node-fetch": "^3.3.2",
    "pino": "^10.4.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.3.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/parser": "^8.72.2",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.1.4",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
